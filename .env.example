# Exemplo de configuração de ambiente
# Copie para .env e ajuste conforme necessário

# Backend
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Timeouts (segundos)
ALIGNMENT_TIMEOUT=3600
TREE_TIMEOUT=7200

# Limites
MAX_FILE_SIZE_MB=50
MAX_SEQUENCES=5000

# Email
SENDGRID_API_KEY=
SENDGRID_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FEEDBACK_TO=
PURGE_EMAIL_ON_COMPLETION=true
PURGE_EMAIL_ON_EXPIRY=true

# Oracle Cloud (para deploy)
# OCIR_REGION=sa-saopaulo-1
# OCIR_TENANCY=your-tenancy
# OCIR_NAMESPACE=your-namespace
